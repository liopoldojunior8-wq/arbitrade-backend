// ─────────────────────────────────────────────────────────
//  ArbitrageAI — Database Schema (PostgreSQL + Prisma ORM)
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum PaymentMethod {
  PAYPAL
  MPESA
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WHATSAPP
  PUSH
}

enum AlertType {
  PRICE_DROP
  ARBITRAGE
  TREND
  STOCK_LOW
  TARGET_REACHED
}

enum Marketplace {
  AMAZON
  EBAY
  WALMART
  ALIEXPRESS
  TEMU
  ALIBABA
  FACEBOOK
  ETSY
  SHOPIFY
}

// ── USER ─────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String?
  googleId      String?  @unique
  appleId       String?  @unique
  avatarUrl     String?
  country       String?
  phone         String?
  telegramId    String?
  isAdmin       Boolean  @default(false)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription  Subscription?
  products      TrackedProduct[]
  alerts        Alert[]
  payments      Payment[]
  sessions      Session[]
  notifications Notification[]

  @@index([email])
  @@map("users")
}

// ── SESSION ──────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

// ── SUBSCRIPTION ─────────────────────────────────────────

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  plan            Plan               @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  paypalSubId     String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean         @default(false)
  trialEndsAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

// ── PAYMENT ──────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Float
  currency       String        @default("USD")
  reference      String?       // PayPal order ID / M-Pesa transaction ID / bank ref
  description    String?
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([reference])
  @@map("payments")
}

// ── PRODUCT ──────────────────────────────────────────────

model Product {
  id          String      @id @default(cuid())
  externalId  String      // ASIN, eBay item ID, etc.
  marketplace Marketplace
  name        String
  brand       String?
  category    String?
  imageUrl    String?
  url         String?
  currentPrice Float?
  currency    String      @default("USD")
  inStock     Boolean     @default(true)
  rating      Float?
  reviewCount Int?
  lastScraped DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  priceHistory  PriceHistory[]
  trackedBy     TrackedProduct[]
  opportunities ArbitrageOpportunity[] @relation("BuyProduct")
  sellOpps      ArbitrageOpportunity[] @relation("SellProduct")

  @@unique([externalId, marketplace])
  @@index([marketplace, category])
  @@map("products")
}

// ── PRICE HISTORY ─────────────────────────────────────────

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  price      Float
  currency   String   @default("USD")
  inStock    Boolean  @default(true)
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ── TRACKED PRODUCT (user's watchlist) ───────────────────

model TrackedProduct {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  targetPrice Float?
  notes       String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("tracked_products")
}

// ── ARBITRAGE OPPORTUNITY ────────────────────────────────

model ArbitrageOpportunity {
  id              String   @id @default(cuid())
  buyProductId    String
  sellProductId   String
  buyPrice        Float
  sellPrice       Float
  estimatedFees   Float
  estimatedShipping Float
  grossProfit     Float
  netProfit       Float
  roi             Float
  aiScore         Int      // 0-100
  aiRiskLevel     String?  // LOW / MEDIUM / HIGH
  isActive        Boolean  @default(true)
  detectedAt      DateTime @default(now())
  expiresAt       DateTime?

  buyProduct  Product @relation("BuyProduct",  fields: [buyProductId],  references: [id])
  sellProduct Product @relation("SellProduct", fields: [sellProductId], references: [id])
  alerts      Alert[]

  @@index([aiScore, isActive])
  @@index([netProfit])
  @@map("arbitrage_opportunities")
}

// ── ALERT ─────────────────────────────────────────────────

model Alert {
  id             String      @id @default(cuid())
  userId         String
  opportunityId  String?
  channel        AlertChannel
  type           AlertType
  title          String
  message        String
  data           Json?
  sent           Boolean     @default(false)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime    @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity ArbitrageOpportunity? @relation(fields: [opportunityId], references: [id])

  @@index([userId, sent])
  @@map("alerts")
}

// ── ALERT RULE (user-defined triggers) ───────────────────

model AlertRule {
  id          String      @id @default(cuid())
  userId      String
  name        String
  channel     AlertChannel
  type        AlertType
  marketplace Marketplace?
  category    String?
  minROI      Float?      @default(15)
  minProfit   Float?      @default(20)
  maxBuyPrice Float?
  targetPrice Float?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@index([userId, isActive])
  @@map("alert_rules")
}

// ── NOTIFICATION ─────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ── SCAN JOB LOG ─────────────────────────────────────────

model ScanJob {
  id           String      @id @default(cuid())
  marketplace  Marketplace
  status       String      // RUNNING / DONE / FAILED
  productsScanned Int      @default(0)
  oppsFound    Int         @default(0)
  durationMs   Int?
  error        String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  @@map("scan_jobs")
}
