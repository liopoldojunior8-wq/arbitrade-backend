# ─────────────────────────────────────────────
#  ArbitrageAI — Environment Variables
#  Copiar para .env e preencher os valores reais
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Exemplo Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/arbitrage_ai

# Redis (cache de preços)
# Exemplo Upstash: redis://default:[password]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troca_por_uma_string_longa_e_aleatoria_minimo_64_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=outro_secret_diferente_para_refresh_token

# ── PAGAMENTOS ────────────────────────────────

# PayPal
PAYPAL_CLIENT_ID=seu_paypal_client_id
PAYPAL_CLIENT_SECRET=seu_paypal_client_secret
PAYPAL_MODE=sandbox   # sandbox | live
PAYPAL_WEBHOOK_ID=seu_webhook_id

# M-Pesa (Vodacom Moçambique — API Daraja)
MPESA_API_KEY=seu_mpesa_api_key
MPESA_PUBLIC_KEY=sua_mpesa_public_key
MPESA_SERVICE_PROVIDER_CODE=171717
MPESA_ENV=sandbox   # sandbox | production

# Transferência Bancária
BANK_ACCOUNT_NAME=ArbitrageAI Lda
BANK_ACCOUNT_NUMBER=1234567890
BANK_NAME=Millennium BIM
BANK_BRANCH=Maputo Central
BANK_SWIFT=BIMMZMMA
BANK_IBAN=MZ59...

# ── EMAIL ─────────────────────────────────────

# Gmail SMTP (ou Resend / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@arbitrageai.com
SMTP_PASS=sua_app_password_do_gmail
EMAIL_FROM=ArbitrageAI <noreply@arbitrageai.com>

# ── ALERTAS ───────────────────────────────────

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_token_do_botfather

# WhatsApp (Twilio ou 360dialog)
WHATSAPP_API_URL=https://waba.360dialog.io/v1/messages
WHATSAPP_API_KEY=sua_api_key

# ── MARKETPLACES ──────────────────────────────

# Amazon Product Advertising API
AMAZON_ACCESS_KEY=sua_access_key
AMAZON_SECRET_KEY=sua_secret_key
AMAZON_PARTNER_TAG=seu_associate_tag
AMAZON_REGION=us-east-1

# eBay Browse API
EBAY_APP_ID=seu_ebay_app_id
EBAY_CERT_ID=seu_cert_id
EBAY_DEV_ID=seu_dev_id

# Walmart Open API
WALMART_CLIENT_ID=seu_client_id
WALMART_CLIENT_SECRET=seu_client_secret

# ── RATE LIMITING ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutos
RATE_LIMIT_MAX=100

# ── GOOGLE AUTH (opcional) ────────────────────
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# ── AUTH EXTRAS ───────────────────────────────────────────
BACKEND_URL=http://localhost:4000

# Apple Sign In
APPLE_CLIENT_ID=com.arbitrageai.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# Apple private key (.p8 file contents, single line with \n)
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----
